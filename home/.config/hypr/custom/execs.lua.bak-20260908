hl.on("hyprland.start", function ()
    -- Animated wallpaper from the Linux Wallpaper Engine GUI's last pick, up as soon as Hyprland
    -- is, plus a static frame of it for ii's lock screen. See the script header for why the
    -- GUI's own autostart is not used.
    hl.exec_cmd("$HOME/.config/hypr/custom/scripts/wallpaper-engine.sh")
end)
