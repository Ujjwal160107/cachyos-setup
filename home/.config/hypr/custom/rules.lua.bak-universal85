-- Transparency: re-enable blur for terminal + file manager
-- (hyprland/rules.lua disables blur globally with a class=".*" wildcard)
-- kitty's own background_opacity handles its transparency (keeps text crisp);
-- this just lets the compositor blur what's behind the punched-through background.
hl.window_rule({match = {class = "^(kitty)$" }, no_blur = false})

-- Dolphin's transparency comes from Kvantum (translucent_windows in MaterialAdw.kvconfig)
hl.window_rule({match = {class = "^(org.kde.dolphin)$" }, no_blur = false})

-- hiring-signals: its LinkedIn browser (window class "hiring-signals") is born on
-- workspace 10, never on the one in use. See ~/dev/hiring-signals/docs/OPERATIONS.md.
hl.window_rule({match = {class = "^(hiring-signals)$" }, workspace = "10 silent"})

-- Universal 85% transparency layer, every window, focused or not.
hl.config({
    decoration = {
        active_opacity     = 0.85,
        inactive_opacity   = 0.85,
        -- Never fade a fullscreen video to show the wallpaper through it.
        fullscreen_opacity = 1.0,
    },
})

-- hyprland/rules.lua:7 kills blur for every window with a `class = ".*"`
-- wildcard. Blur is what turns the transparency into frosted glass, so
-- override it. blur.xray = true means it samples the wallpaper, not the
-- windows stacked behind.
hl.window_rule({ match = { class = ".*" }, no_blur = false })

-- Re-assert the one exemption the wildcard clobbers. Order matters: last
-- matching rule wins. Blurring xwayland's zero-class context menus smears
-- them into whatever is underneath.
hl.window_rule({ match = { class = "^()$", title = "^()$" }, no_blur = true })
