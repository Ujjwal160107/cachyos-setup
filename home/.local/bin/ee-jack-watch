#!/usr/bin/env bash
# Speakers and headphones share one PipeWire sink on the ALC257, so
# EasyEffects' own autoload (keyed on device + profile) can't tell them
# apart. Only the active port changes. Watch for that and switch by hand.
set -uo pipefail

SINK=alsa_output.pci-0000_00_1f.3.analog-stereo
SPEAKER_PRESET=${EE_SPEAKER_PRESET:-Speakers-Balanced}
HEADPHONE_PRESET=${EE_HEADPHONE_PRESET:-Headphones-Reference}

current_port() {
  pactl list sinks | awk -v s="$SINK" '
    $1 == "Name:"  { in_sink = ($2 == s) }
    in_sink && $1 == "Active" && $2 == "Port:" { print $3; exit }'
}

apply() {
  case "$1" in
    analog-output-headphones) easyeffects -l "$HEADPHONE_PRESET" || true ;;
    analog-output-speaker)    easyeffects -l "$SPEAKER_PRESET"   || true ;;
  esac
}

last=$(current_port)
apply "$last"

pactl subscribe | grep --line-buffered "on sink " | while read -r _; do
  port=$(current_port)
  [ "$port" = "$last" ] && continue
  last="$port"
  apply "$port"
done
