#!/bin/sh
export WINEPREFIX="$HOME/Games/windows"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
export WINEPATH="$HOME/.local/share/Steam/ubuntu12_32/steam-runtime"

# Force native crack DLLs and allow native stub loading for the overlay modules
export WINEDLLOVERRIDES="winmm,version,OnlineFix64=n,b;gameoverlayrenderer,gameoverlayrenderer64=n"

# Force environment to skip sandbox testing modes and hook directly into active client context
export STEAM_COMPAT_DATA_PATH="$HOME/.local/share/Steam/steamapps/compatdata/480"
export PFX=1

# Force execution on the dedicated NVIDIA RTX 3050 GPU
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

[ -f "$1" ] || { echo "usage: run-exe path/to/program.exe" >&2; exit 1; }
log="$HOME/.local/state/run-exe.log"
mkdir -p "$(dirname "$log")"
cd "$(dirname "$1")"

echo "=== $(date '+%F %T') $1" >>"$log"

if [ ! -f "steam_appid.txt" ]; then
    echo "steam_appid.txt not found. Scanning configurations..." >>"$log"
    FOUND_ID=$(grep -rih "appid\s*=" ./*.ini 2>/dev/null | head -n 1 | grep -o '[0-9]\+')
    if [ -n "$FOUND_ID" ]; then
        echo "$FOUND_ID" > "steam_appid.txt"
    else
        echo "480" > "steam_appid.txt"
    fi
fi

PROTON_DIR="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-11-x86_64"

if [ -f "$PROTON_DIR/proton-ge" ]; then
    RUNNER="$PROTON_DIR/proton-ge"
else
    RUNNER="$PROTON_DIR/proton"
fi

exec "$RUNNER" run "$1" >>"$log" 2>&1
