diff --git a/modules/common/widgets/TouchpadScrollArea.qml b/modules/common/widgets/TouchpadScrollArea.qml
new file mode 100644
index 0000000..e5f42e9
--- /dev/null
+++ b/modules/common/widgets/TouchpadScrollArea.qml
@@ -0,0 +1,113 @@
+import QtQuick
+import qs.modules.common
+
+/**
+ * Apply shared touchpad sensitivity after content and nested controls have
+ * received input. Mouse-wheel notches and horizontal-only gestures use Qt.
+ * In ScrollView, declare this as an object property to keep it out of the
+ * control's default contentData. TextArea still supplies the content size.
+ */
+MouseArea {
+    id: root
+
+    required property Flickable flickable
+    property real touchpadScrollFactor: Config.options.interactions.scrolling.touchpadScrollFactor
+    property real touchpadSensitivity: Config.options.interactions.scrolling.touchpadSensitivity
+    readonly property bool scrolling: scrollTimer.running
+
+    // Normalize old absolute values against 450, preserving ratios rather
+    // than the old absolute movement speed.
+    readonly property real relativeFactor: touchpadScrollFactor > 10
+        ? touchpadScrollFactor / 450 : Math.max(0, touchpadScrollFactor)
+    property bool _pixelGesture: false
+    // Keep ownership until the phase reset, even when the inactivity timer expires.
+    property bool _enhancedGesture: false
+
+    // Stay in the viewport, behind content so nested views and wheel controls
+    // can handle input before it reaches this area's native Flickable parent.
+    parent: flickable.contentItem
+    x: flickable.contentX
+    y: flickable.contentY
+    width: flickable.width
+    height: flickable.height
+    z: -1
+    visible: Config.options.interactions.scrolling.fasterTouchpadScroll
+    enabled: flickable.interactive
+        && flickable.contentHeight + flickable.topMargin + flickable.bottomMargin > flickable.height
+        && flickable.flickableDirection !== Flickable.HorizontalFlick
+    acceptedButtons: Qt.NoButton
+
+    Timer {
+        id: scrollTimer
+        interval: 120
+        onTriggered: root._pixelGesture = false
+    }
+
+    // Native Qt tracking cannot resume halfway through our direct movement:
+    // it still has the old press origin. Chain enhanced movement explicitly.
+    function chainScroll(event) {
+        event.accepted = true
+        for (let ancestor = root.flickable.parent; ancestor; ancestor = ancestor.parent) {
+            if (!(ancestor instanceof Flickable)) continue
+            for (const child of ancestor.contentItem.children) {
+                if (child instanceof TouchpadScrollArea && child.enabled && child.visible) {
+                    child.handleWheel(event)
+                    event.accepted = true
+                    return
+                }
+            }
+        }
+    }
+
+    function handleWheel(event) {
+        event.accepted = false
+        const f = root.flickable
+        const dx = event.angleDelta.x
+        const dy = event.angleDelta.y
+        const px = event.pixelDelta.x
+        const py = event.pixelDelta.y
+        if (dx === 0 && dy === 0 && px === 0 && py === 0) {
+            root._pixelGesture = false
+            root._enhancedGesture = false
+            scrollTimer.stop()
+            // Qt needs gesture begin/end events to maintain its own tracking.
+            return
+        }
+        // A horizontal-only gesture starts with native Qt scrolling. Once
+        // enhanced tracking starts, keep both axes on the same path until end.
+        if (!root._enhancedGesture && dy === 0 && py === 0) return
+        // A mouse notch must pass through even just after a pixel gesture.
+        if (px === 0 && py === 0 && dy !== 0 && Math.abs(dy) % 120 === 0) return
+
+        root._enhancedGesture = true
+        if (px !== 0 || py !== 0) root._pixelGesture = true
+        scrollTimer.restart()
+        if (px === 0 && py === 0 && root._pixelGesture) {
+            // Ignore a rounded-to-zero pixel sample without changing units.
+            event.accepted = true
+            return
+        }
+        const scale = root.touchpadSensitivity * root.relativeFactor
+        const deltaY = -(root._pixelGesture ? py : dy / 12) * scale
+        const minY = f.originY - f.topMargin
+        const maxY = Math.max(minY, f.originY + f.contentHeight - f.height + f.bottomMargin)
+        const targetY = Math.max(minY, Math.min(maxY, f.contentY + deltaY))
+        const horizontal = f.flickableDirection !== Flickable.VerticalFlick
+            && f.contentWidth + f.leftMargin + f.rightMargin > f.width
+        const deltaX = horizontal ? -(root._pixelGesture ? px : dx / 12) * scale : 0
+        const minX = f.originX - f.leftMargin
+        const maxX = Math.max(minX, f.originX + f.contentWidth - f.width + f.rightMargin)
+        const targetX = horizontal ? Math.max(minX, Math.min(maxX, f.contentX + deltaX)) : f.contentX
+        if (targetY === f.contentY && targetX === f.contentX && (deltaY !== 0 || deltaX !== 0)) {
+            root.chainScroll(event)
+            return
+        }
+
+        f.cancelFlick()
+        if (horizontal) f.contentX = targetX
+        f.contentY = targetY
+        event.accepted = true
+    }
+
+    onWheel: event => root.handleWheel(event)
+}
diff --git a/modules/common/widgets/WallpaperGlass.qml b/modules/common/widgets/WallpaperGlass.qml
new file mode 100644
index 0000000..1a60860
--- /dev/null
+++ b/modules/common/widgets/WallpaperGlass.qml
@@ -0,0 +1,29 @@
+import QtQuick
+import qs.modules.common
+
+// Nothing Liquid's shell-side glass for panes drawn on the wallpaper layer.
+LiquidGlassEffect {
+    id: root
+    readonly property bool light: !Appearance.m3colors.darkmode
+    readonly property var settings: Config.options.appearance.liquidGlass
+    property real radius: Appearance.rounding.verylarge
+
+    brightness: root.light ? 1.03 : 0.8
+    adaptiveDim: root.light ? 0 : 0.8
+    adaptiveBoost: root.light ? 0.85 : 0
+    tint: root.light ? Qt.rgba(0.98, 0.98, 0.99, 0.45) : Qt.rgba(0.04, 0.04, 0.05, 0.25)
+    shadow: root.light ? 0.2 : 0.28
+    refraction: 18 * root.settings.refraction
+    bodyLens: 0.03 * root.settings.refraction
+    rim: 0.75 * root.settings.edgeHighlight
+    frost: root.settings.mode === "tinted" ? 0.8 + root.settings.tintAmount : 0.8
+    highlightDirection: ({ "none": 0, "top": 1, "diagonal": 2 })[root.settings.highlights] ?? 1
+    darkEdge: root.settings.darkEdge ? (root.light ? 0.43 : 0.88) : 0
+    nearReflection: root.settings.nearReflection ? 0.5 : 0
+
+    Rectangle {
+        anchors.fill: parent
+        radius: root.radius
+        color: "white"
+    }
+}
diff --git a/modules/common/widgets/WidgetCard.qml b/modules/common/widgets/WidgetCard.qml
new file mode 100644
index 0000000..9806380
--- /dev/null
+++ b/modules/common/widgets/WidgetCard.qml
@@ -0,0 +1,30 @@
+import QtQuick
+import qs.modules.common
+
+Rectangle {
+    id: root
+    required property var widget
+    property bool shadowed: Config.options.background.widgets.shadow
+    property bool glass: true
+
+    radius: Appearance.rounding?.verylarge ?? 30
+    color: glass && Appearance.liquidGlass ? "transparent" : Appearance.colors.colPrimaryContainer
+
+    StyledRectangularShadow {
+        target: root
+        z: -2
+        visible: root.shadowed && !Appearance.liquidGlass
+    }
+
+    Loader {
+        anchors.fill: parent
+        active: root.glass && Appearance.liquidGlass
+        sourceComponent: WallpaperGlass {
+            backdrop: root.widget.wallpaperItem
+            radius: root.radius
+            mapPosition: Qt.point(root.widget.x + root.x - root.widget.wallpaperItem.x,
+                root.widget.y + root.y - root.widget.wallpaperItem.y)
+            mapScale: root.widget.scale
+        }
+    }
+}
diff --git a/modules/common/widgets/WidgetFlipHandle.qml b/modules/common/widgets/WidgetFlipHandle.qml
new file mode 100644
index 0000000..3ffb8fa
--- /dev/null
+++ b/modules/common/widgets/WidgetFlipHandle.qml
@@ -0,0 +1,68 @@
+import QtQuick
+import qs.modules.common
+
+Item {
+    id: root
+
+    required property Item anchorItem
+    property bool hoverActive: false
+    property bool locked: false
+    property string icon: "rotate_right"
+    property real handleSize: 22
+    property int quarterTurns: 0
+    property string corner: "bottomRight"
+    readonly property bool engaged: area.containsMouse || area.pressed
+
+    signal clicked()
+
+    width: root.handleSize
+    height: root.handleSize
+    anchors {
+        horizontalCenter: root.anchorItem.right
+        verticalCenter: root.corner === "topRight" ? root.anchorItem.top : root.anchorItem.bottom
+        horizontalCenterOffset: -2
+        verticalCenterOffset: root.corner === "topRight" ? 2 : -2
+    }
+    opacity: (root.hoverActive || root.engaged) ? 1 : 0
+    visible: opacity > 0 && !root.locked
+    scale: root.engaged ? 1.18 : 1
+
+    Behavior on opacity {
+        NumberAnimation { duration: 150 }
+    }
+    Behavior on scale {
+        NumberAnimation { duration: 220; easing.type: Easing.OutBack; easing.overshoot: 2.4 }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: width / 2
+        color: "#ffffff"
+        border.width: 2
+        border.color: "#101010"
+    }
+
+    MaterialSymbol {
+        anchors.centerIn: parent
+        text: root.icon
+        iconSize: 13
+        color: "#101010"
+        rotation: root.quarterTurns * 90
+
+        Behavior on rotation {
+            SpringAnimation { spring: 4.5; damping: 0.3; epsilon: 0.5 }
+        }
+    }
+
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        anchors.margins: -6
+        hoverEnabled: true
+        cursorShape: Qt.PointingHandCursor
+        onClicked: {
+            root.quarterTurns += 1
+            root.clicked()
+        }
+    }
+}
