+                        text: root.today.toLocaleDateString(Qt.locale(), "MMMM yyyy")
+                        font.pixelSize: Appearance.font.pixelSize.small
+                        font.weight: Font.Bold
+                        color: Appearance.colors.colOnPrimary
+                    }
+                }
+
+                Grid {
+                    columns: 7
+                    rowSpacing: 4
