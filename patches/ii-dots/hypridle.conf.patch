--- a/.config/hypr/hypridle.conf
+++ b/.config/hypr/hypridle.conf
@@ -1,6 +1,7 @@
 $lock_cmd = hyprctl dispatch 'hl.dsp.global("quickshell:lock")' & pidof qs quickshell hyprlock || hyprlock
 # $lock_cmd = pidof hyprlock || hyprlock
-$suspend_cmd = systemctl suspend || loginctl suspend
+# Prefix for idle actions that should only happen on battery.
+$unless_ac = ~/.local/bin/unless-ac
 
 general {
     lock_cmd = $lock_cmd
@@ -11,16 +12,16 @@
 
 listener {
     timeout = 300 # 5mins
-    on-timeout = loginctl lock-session
+    on-timeout = $unless_ac loginctl lock-session
 }
 
 listener {
     timeout = 600 # 10mins
-    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })'
+    on-timeout = $unless_ac hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })'
     on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })'
 }
 
 listener {
     timeout = 900 # 15mins
-    on-timeout = $suspend_cmd
+    on-timeout = $unless_ac sh -c 'systemctl suspend || loginctl suspend'
 }
